{% assign collabs = site.data.collaborators | default: empty %}
<script>
  document.addEventListener('readystatechange', () => {
    if (document.readyState !== 'complete') return;

    const data = {{ collabs | jsonify }};
    const el = document.getElementById('collaborators-map');
    if (!el) return;

    // Basic world map
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // Ensure marker icon assets resolve correctly (Leaflet otherwise tries relative to the page).
    const leafletImgBase = "{{ site.third_party_libraries.leaflet.url.images }}";
    L.Icon.Default.mergeOptions({
      iconRetinaUrl: `${leafletImgBase}marker-icon-2x.png`,
      iconUrl: `${leafletImgBase}marker-icon.png`,
      shadowUrl: `${leafletImgBase}marker-shadow.png`,
    });

    const bounds = [];

    data.forEach((c) => {
      if (c.lat == null || c.lng == null) return;
      // Simple red dot marker (avoid broken thumbnail/icon assets)
      const marker = L.circleMarker([c.lat, c.lng], {
        radius: 6,
        color: '#b00020',
        weight: 2,
        fillColor: '#e53935',
        fillOpacity: 0.95,
      }).addTo(map);
      bounds.push([c.lat, c.lng]);

      const photo = c.photo ? `<img src="/${c.photo.replace(/^\//, '')}" style="width:64px;height:64px;object-fit:cover;border-radius:8px;margin-right:10px;" />` : '';
      const name = c.name ? `<div style="font-weight:600;">${c.name}</div>` : '';
      const inst = c.institution ? `<div style="font-size:0.9em;">${c.institution}</div>` : '';

      const html = `<div style="display:flex;align-items:center;">${photo}<div>${name}${inst}</div></div>`;

      marker.bindPopup(html, { closeButton: false, autoClose: true, closeOnClick: false });
      marker.on('mouseover', () => marker.openPopup());
      marker.on('mouseout', () => marker.closePopup());
    });

    const setViewSafe = () => {
      // Leaflet often needs an explicit invalidateSize after layout/fonts settle,
      // otherwise tiles can render offset / duplicated.
      map.invalidateSize(true);
      if (bounds.length) {
        map.fitBounds(bounds, { padding: [30, 30] });
      } else {
        map.setView([20, 0], 2);
      }
    };

    // Run once now, then again after a couple of frames.
    setViewSafe();
    requestAnimationFrame(() => requestAnimationFrame(setViewSafe));

    // Also fix up after window resizes (e.g., mobile rotation, font load reflow)
    window.addEventListener('resize', () => {
      setTimeout(setViewSafe, 150);
    });
  });
</script>
