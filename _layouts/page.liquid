---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header page-hero{% if page.img %} page-hero-has-media{% endif %}">
    <div class="page-hero-copy">
      {% if page.eyebrow %}
        <p class="page-eyebrow">{{ page.eyebrow }}</p>
      {% endif %}
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
      {% if page.intro %}
        <p class="page-intro">{{ page.intro }}</p>
      {% endif %}
    </div>
    {% if page.img %}
      <div class="page-hero-media">
        {% include figure.liquid loading="eager" path=page.img class="page-hero-image" alt=page.title cache_bust=true %}
      </div>
    {% endif %}
  </header>

  <article class="page-body">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
